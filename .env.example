APP_NAME=OpenStudy AI

OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192

AGENT_BATCH_DOCUMENTS=true
AGENT_MAX_SOURCE_CHARS=2800

WHATSAPP_POLL_INTERVAL_SECONDS=0.4

DATABASE_URL=sqlite:///./data/openstudy.db
UPLOADS_DIR=data/uploads
MAX_UPLOAD_MB=30
MAX_DOCUMENT_CHARS=300000
CHUNK_SIZE=6000
CHUNK_OVERLAP=450

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=300
# Fallback automático quando o provedor em nuvem estiver ocupado/indisponível.
# O modelo local precisa estar instalado no Ollama (ollama pull qwen2.5:7b).
OLLAMA_FALLBACK_ENABLED=true
# Deixe vazio para usar OLLAMA_MODEL, ou informe um modelo local mais leve.
OLLAMA_FALLBACK_MODEL=
# Evita esperar até 300s em uma API remota sobrecarregada.
REMOTE_LLM_TIMEOUT_SECONDS=60
# Evita recarregar o modelo a cada tarefa. Ajuste NUM_CTX à RAM/VRAM disponível.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192
# Agentes: lotes de 2 trechos, até 14 mil caracteres; pode desativar se necessário.
AGENT_BATCH_DOCUMENTS=true
AGENT_MAX_SOURCE_CHARS=2800
WHATSAPP_POLL_INTERVAL_SECONDS=0.4

APP_ENCRYPTION_KEY=
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.12
TARGET_RETENTION=0.90

APP_UID=1000
APP_GID=1000

WHATSAPP_ENABLED=true
COMPOSE_PROFILES=${WHATSAPP_ENABLED:-false}
EVOLUTION_DB_PASSWORD=change-this-evolution-db-password-before-production
EVOLUTION_GLOBAL_API_KEY=change-this-evolution-global-api-key-before-production
EVOLUTION_INSTANCE_TOKEN=change-this-instance-token-32chars
EVOLUTION_INSTANCE_NAME=openstudy-assistant
EVOLUTION_WEBHOOK_SECRET=change-this-webhook-secret-before-production

EVOLUTION_WEBHOOK_BASE_URL=http://app:8000


WHATSAPP_DEFAULT_COUNTRY_CODE=55
WHATSAPP_MAX_MEDIA_MB=15
WHATSAPP_SCHEDULER_ENABLED=true
WHATSAPP_SCHEDULER_INTERVAL_SECONDS=20

# --- Segurança da interface e da API ---
# Padrão: basic. No primeiro início, uma senha longa é gerada em data/.openstudy-admin-password.
# Usuário padrão: admin. Basic Auth exige HTTPS ao abrir fora do próprio PC.
OPENSTUDY_AUTH_MODE=basic
# O modo "basic" agora utiliza uma tela de login própria e cookie de sessão.
OPENSTUDY_ADMIN_USER=admin
# Opcional: senha do login antigo. A nova conta usa hash scrypt, salvo em data/.openstudy-owner.json.
OPENSTUDY_ADMIN_PASSWORD=
# Origens HTTPS adicionais permitidas para ações do navegador (se usar proxy remoto).
OPENSTUDY_ALLOWED_ORIGINS=
# Somente para integrações HTTP externas como n8n (>=32 caracteres aleatórios).
OPENSTUDY_SERVICE_API_TOKEN=

# --- PostgreSQL opcional (somente ao migrar com compose.postgres.yaml) ---
# OPENSTUDY_DB_PASSWORD=defina-uma-senha-aleatoria-longa
